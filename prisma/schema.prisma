generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id
  email                 String    @unique
  name                  String?
  avatarUrl             String?
  isAdmin               Boolean   @default(false)
  onboardingCompletedAt DateTime?

  // Public record: off until the member turns it on; served at /u/{username}
  username        String? @unique
  recordPublic    Boolean @default(false)
  // Note and Open questions are left out of the public record unless the member includes them
  recordShowNotes Boolean @default(false)
  // Named on public plant pages for the care they log; off until the member opts in
  creditOnPlants  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  sceneAssignments      SceneAssignment[]
  sceneAssignmentsGiven SceneAssignment[]  @relation("AssignedBy")
  taskAssignments       TaskAssignee[]     @relation("AssignedTasks")
  taskAssignmentsGiven  TaskAssignee[]     @relation("TaskAssignedBy")
  createdTasks          Task[]             @relation("CreatedTasks")
  workRecords           WorkRecord[]
  workRecordEdits       WorkRecordEdit[]   @relation("WorkRecordEditedBy")
  workLogEntryEdits     WorkLogEntryEdit[] @relation("WorkLogEntryEditedBy")
}

// ─── Organisations ────────────────────────────────────────────────────────────

model Organisation {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  logoUrl       String?
  directorLabel String  @default("Director")
  managerLabel  String  @default("Manager")
  memberLabel   String  @default("Member")

  // Where the garden is, for the weather bar. Coordinates come from the postcode.
  postcode  String?
  latitude  Float?
  longitude Float?

  // Whether members' public records may show plants worked with here
  recordsPublic          Boolean @default(true)
  // When they may not: whether the summary line names the organisation
  privateRecordsShowName Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  specimens       Specimen[]
  scenes          Scene[]
  collections     Collection[]
  collectionTypes CollectionType[]
  tasks           Task[]
  workRecords     WorkRecord[]
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
}

enum MembershipRole {
  DIRECTOR
  MANAGER
  MEMBER
}

// ─── Species (shared across all organisations) ────────────────────────────────

model Species {
  id                 String  @id @default(cuid())
  slug               String  @unique
  commonName         String
  scientificName     String
  family             String?
  origin             String?
  description        String?
  // Kept for backward-compat during transition; superseded by statusCategory below
  conservationStatus String?
  powoUrl            String?
  // Identity in the botanical name sources, so the same taxon can't be added twice
  colId              String? @unique
  ipniId             String? @unique
  nameKey            String? @unique
  authority          String?
  photoUrl           String?
  photoAttribution   String?
  photoLicence       String?
  photoSourceUrl     String?
  inatTaxonId        Int?

  // British Ellenberg indicator values (Hill et al., PLANTATT, BRC/UKCEH, OGL v3)
  ellenbergL      Int? // Light: 1 (deep shade) to 9 (full sun)
  ellenbergF      Int? // Moisture: 1 (very dry) to 12 (submerged)
  ellenbergR      Int? // Soil reaction (pH): 1 (very acid) to 9 (strongly basic)
  ellenbergN      Int? // Nitrogen: 1 (very infertile) to 9 (very fertile)
  ellenbergS      Int? // Salt: 0 (none) to 9 (highly saline)
  ellenbergSource String? // e.g. "PLANTATT (Hill et al., 2004)"

  // Open-data fields — populated automatically from Wikidata / POWO / GBIF / Wikipedia
  statusCategory       String? // Plain-English IUCN category e.g. "Endangered"
  statusSource         String? // "Wikidata" | "JNCC" | "Manual"
  statusUpdatedAt      DateTime?
  nativeRegions        String[] // Human-readable region names from POWO e.g. ["Mauritius"]
  introducedRegions    String[] // Human-readable region names from POWO
  lifeForm             String? // e.g. "Shrub"
  climate              String? // e.g. "Tropical"
  habitatExcerpt       String? // Wikipedia excerpt
  habitatExcerptSource String? // Wikipedia article URL
  gbifTaxonKey         Int? // GBIF backbone key, for occurrence maps
  openDataUpdatedAt    DateTime? // When this species' open-data was last refreshed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specimens Specimen[]
}

// ─── Collections ──────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Optional kind of collection, defined by the organisation (e.g. Location, Taxonomy)
  typeId String?
  type   CollectionType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  specimens     CollectionMembership[]
  primaryScenes Scene[]                @relation("PrimaryCollection")

  @@unique([slug, organisationId])
}

/// A kind of collection an organisation names for itself (e.g. Location, Taxonomy).
/// Managed on the Collections page; deleting one leaves its collections untyped.
model CollectionType {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  collections Collection[]

  @@unique([organisationId, name])
}

// ─── Scenes ────────────────────────────────────────────────────────────────────

enum ScenePerspective {
  BED
  WALL
}

model Scene {
  id          String           @id @default(cuid())
  slug        String
  name        String
  perspective ScenePerspective @default(BED)
  gridRows    Int              @default(4)
  gridCols    Int              @default(4)
  /// 0: odd rows are offset half a cell right; 1: even rows are. Flips when a row is added or removed at the top.
  rowShift    Int              @default(0)
  /// Hexes ("row,col") split into seven smaller cells; plants in them are at "row,col:0"–"row,col:6"
  splitCells  String[]         @default([])
  /// Optional title shown on screen beside the name; never printed on the QR label
  title       String?
  /// In use at the venue. Pre-made scenes (with labels printed ahead) start inactive.
  active      Boolean          @default(true)
  shortCode   String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  primaryCollectionId String?
  primaryCollection   Collection? @relation("PrimaryCollection", fields: [primaryCollectionId], references: [id], onDelete: SetNull)

  specimens   Specimen[]
  assignments SceneAssignment[]
  tasks       Task[]

  @@unique([slug, organisationId])
}

// ─── Scene assignments (member ↔ scene responsibility) ─────────────────────────

model SceneAssignment {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([sceneId, userId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(OPEN)
  // Set when ticked off; care logged from the task is dated to this
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  assignees TaskAssignee[]

  // Optional target and care action: ticking the task off logs the care on each
  // target plant for each assignee. The target is one plant, or a scene (all of
  // it, or the cells listed as "row,col").
  specimenId      String?
  specimen        Specimen?      @relation(fields: [specimenId], references: [id], onDelete: SetNull)
  sceneId         String?
  scene           Scene?         @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  cells           String[]       @default([])
  // The plants care was logged on, fixed when ticked off so later moves don't rewrite history
  careSpecimenIds String[]       @default([])
  careAction      WorkAction?
  careEntries     WorkLogEntry[]

  createdById String?
  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organisationId])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("AssignedTasks", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([userId])
}

enum TaskStatus {
  OPEN
  DONE
}

// ─── Specimens ────────────────────────────────────────────────────────────────

model Specimen {
  id              String   @id @default(cuid())
  slug            String
  // Cultivar name without quotes, e.g. Flamingo; the species stays the botanical taxon
  cultivar        String?
  accessionNumber String?
  notes           String?
  imageUrl        String?
  gridCell        String? // e.g. "2,3" (row,col)
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id])

  sceneId String?
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  collections CollectionMembership[]
  workRecords WorkRecord[]
  tasks       Task[]

  @@unique([slug, organisationId])
}

// ─── Collection membership (specimen ↔ collection, many-to-many) ──────────────

model CollectionMembership {
  specimenId String
  specimen   Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade)

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([specimenId, collectionId])
}

// ─── Work records ─────────────────────────────────────────────────────────────

enum WorkAction {
  PLANTED
  POTTED_ON
  REPOTTED
  PRUNED
  WATERED
  FED
  PROPAGATED
  DIVIDED
  STAKED
  WEEDED
  MULCHED
  PEST_DISEASE_TREATMENT
  LABELLED
  SURVEYED
  OTHER
}

// One per member per specimen. recordNumber is sequential per user (their personal record book).
model WorkRecord {
  id           String @id @default(cuid())
  recordNumber Int

  // Date of first work (date portion used; stored as DateTime for Prisma compatibility)
  firstWorkedDate DateTime

  // Species fields denormalised at record creation for archival integrity
  scientificName String
  family         String?

  // Name as recorded: botanical parts wrapped in <i>…</i>, authority upright
  nameHtml  String?
  authority String?

  // Plant facts as recorded by the member (botany record-book order)
  commonNames String?
  nativeRange String?
  habit       String?
  diagnostic  String?
  nearMisses  String?
  powoUrl     String?
  // Site as recorded, e.g. "Lullingstone Castle, Eynsford, Kent"
  site        String?

  // Where exactly
  location   String?
  viceCounty String?
  gridRef    String?

  // Projects this record belongs to
  projects String[] @default([])

  // Set when the plant was also studied, not only worked with: how
  howStudied String?

  // Botany-standard fields (all optional; null = not yet recorded)
  determination String?
  labelText     String?
  provenance    String?
  workDone      String?
  observed      String?
  note          String?
  sources       String?
  openQuestions String?

  // Sharing: opt-in public link via a random token
  shareToken String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specimenId String
  specimen   Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade)

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  logEntries  WorkLogEntry[]
  editHistory WorkRecordEdit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, specimenId])
  @@unique([userId, recordNumber])
  @@index([specimenId])
  @@index([userId])
}

model WorkLogEntry {
  id         String     @id @default(cuid())
  date       DateTime
  action     WorkAction
  actionNote String? // free text; always shown when action = OTHER
  location   String?
  text       String?

  workRecordId String
  workRecord   WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  // Set when the entry was logged by ticking off a to-do
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  editHistory WorkLogEntryEdit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workRecordId, date])
  @@index([date])
  @@index([taskId])
}

model WorkRecordEdit {
  id       String   @id @default(cuid())
  field    String
  oldValue String?
  newValue String?
  editedAt DateTime @default(now())

  editedById String?
  editedBy   User?   @relation("WorkRecordEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  workRecordId String
  workRecord   WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)
}

model WorkLogEntryEdit {
  id       String   @id @default(cuid())
  field    String
  oldValue String?
  newValue String?
  editedAt DateTime @default(now())

  editedById String?
  editedBy   User?   @relation("WorkLogEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  workLogEntryId String
  workLogEntry   WorkLogEntry @relation(fields: [workLogEntryId], references: [id], onDelete: Cascade)
}

/// A change a member made offline and sent later. The id comes from their
/// device, so sending the same change twice only applies it once.
model SyncOp {
  id        String   @id
  kind      String
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}
