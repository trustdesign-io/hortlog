generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                    String       @id
  email                 String       @unique
  name                  String?
  avatarUrl             String?
  isAdmin               Boolean      @default(false)
  onboardingCompletedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  memberships           Membership[]
  viewAssignments       ViewAssignment[]
  viewAssignmentsGiven  ViewAssignment[]   @relation("AssignedBy")
  assignedTasks         Task[]             @relation("AssignedTasks")
  createdTasks          Task[]             @relation("CreatedTasks")
  workRecords           WorkRecord[]
  workRecordEdits       WorkRecordEdit[]   @relation("WorkRecordEditedBy")
  workLogEntryEdits     WorkLogEntryEdit[] @relation("WorkLogEntryEditedBy")
}

// ─── Organisations ────────────────────────────────────────────────────────────

model Organisation {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  logoUrl        String?
  managerLabel   String       @default("Manager")
  memberLabel    String       @default("Member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    Membership[]
  specimens      Specimen[]
  views          View[]
  collections    Collection[]
  tasks          Task[]
  workRecords    WorkRecord[]
}

model Membership {
  id             String           @id @default(cuid())
  role           MembershipRole
  createdAt      DateTime         @default(now())

  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
}

enum MembershipRole {
  MANAGER
  MEMBER
}

// ─── Species (shared across all organisations) ────────────────────────────────

model Species {
  id                 String     @id @default(cuid())
  slug               String     @unique
  commonName         String
  scientificName     String
  family             String?
  origin             String?
  description        String?
  conservationStatus String?
  powoUrl            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  specimens          Specimen[]
}

// ─── Collections ──────────────────────────────────────────────────────────────

model Collection {
  id             String                @id @default(cuid())
  slug           String
  name           String
  description    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organisationId String
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  specimens      CollectionMembership[]
  primaryViews   View[]                @relation("PrimaryCollection")

  @@unique([slug, organisationId])
}

// ─── Views ────────────────────────────────────────────────────────────────────

model View {
  id                  String     @id @default(cuid())
  slug                String
  name                String
  gridRows            Int        @default(4)
  gridCols            Int        @default(4)
  shortCode           String     @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  primaryCollectionId String?
  primaryCollection   Collection?  @relation("PrimaryCollection", fields: [primaryCollectionId], references: [id], onDelete: SetNull)

  specimens           Specimen[]
  assignments         ViewAssignment[]

  @@unique([slug, organisationId])
}

// ─── View assignments (member ↔ view responsibility) ─────────────────────────

model ViewAssignment {
  id           String   @id @default(cuid())
  assignedAt   DateTime @default(now())

  viewId       String
  view         View     @relation(fields: [viewId], references: [id], onDelete: Cascade)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedById String
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id])

  @@unique([viewId, userId])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  status         TaskStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  assigneeId     String?
  assignee       User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById    String
  createdBy      User         @relation("CreatedTasks", fields: [createdById], references: [id])
}

enum TaskStatus {
  OPEN
  DONE
}

// ─── Specimens ────────────────────────────────────────────────────────────────

model Specimen {
  id              String     @id @default(cuid())
  slug            String
  accessionNumber String?
  notes           String?
  imageUrl        String?
  gridCell        String?    // e.g. "2,3" (row,col)
  latitude        Float?
  longitude       Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  speciesId       String
  species         Species      @relation(fields: [speciesId], references: [id])

  viewId          String?
  view            View?        @relation(fields: [viewId], references: [id], onDelete: SetNull)

  collections     CollectionMembership[]
  workRecords     WorkRecord[]

  @@unique([slug, organisationId])
}

// ─── Collection membership (specimen ↔ collection, many-to-many) ──────────────

model CollectionMembership {
  specimenId    String
  specimen      Specimen   @relation(fields: [specimenId], references: [id], onDelete: Cascade)

  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([specimenId, collectionId])
}

// ─── Work records ─────────────────────────────────────────────────────────────

enum WorkAction {
  PLANTED
  POTTED_ON
  REPOTTED
  PRUNED
  WATERED
  FED
  PROPAGATED
  DIVIDED
  STAKED
  WEEDED
  MULCHED
  PEST_DISEASE_TREATMENT
  LABELLED
  SURVEYED
  OTHER
}

// One per member per specimen. recordNumber is sequential per user (their personal record book).
model WorkRecord {
  id              String   @id @default(cuid())
  recordNumber    Int

  // Date of first work (date portion used; stored as DateTime for Prisma compatibility)
  firstWorkedDate DateTime

  // Species fields denormalised at record creation for archival integrity
  scientificName  String
  family          String?

  // Botany-standard fields (all optional; null = not yet recorded)
  determination   String?
  labelText       String?
  provenance      String?
  workDone        String?
  observed        String?
  note            String?
  sources         String?
  openQuestions   String?

  // Sharing: opt-in public link via a random token
  shareToken      String?  @unique

  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  specimenId      String
  specimen        Specimen     @relation(fields: [specimenId], references: [id], onDelete: Cascade)

  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  logEntries      WorkLogEntry[]
  editHistory     WorkRecordEdit[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, specimenId])
  @@unique([userId, recordNumber])
  @@index([specimenId])
  @@index([userId])
}

model WorkLogEntry {
  id           String     @id @default(cuid())
  date         DateTime
  action       WorkAction
  actionNote   String?    // free text; always shown when action = OTHER
  location     String?
  text         String?

  workRecordId String
  workRecord   WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  editHistory  WorkLogEntryEdit[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workRecordId, date])
  @@index([date])
}

model WorkRecordEdit {
  id           String     @id @default(cuid())
  field        String
  oldValue     String?
  newValue     String?
  editedAt     DateTime   @default(now())

  editedById   String
  editedBy     User       @relation("WorkRecordEditedBy", fields: [editedById], references: [id])

  workRecordId String
  workRecord   WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)
}

model WorkLogEntryEdit {
  id             String       @id @default(cuid())
  field          String
  oldValue       String?
  newValue       String?
  editedAt       DateTime     @default(now())

  editedById     String
  editedBy       User         @relation("WorkLogEntryEditedBy", fields: [editedById], references: [id])

  workLogEntryId String
  workLogEntry   WorkLogEntry @relation(fields: [workLogEntryId], references: [id], onDelete: Cascade)
}
