{
  "installCommand": "npm ci",
  "buildCommand": "npx prisma generate && node scripts/migrate-on-deploy.mjs && next build",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-open-data",
      "schedule": "17 3 * * *"
    }
  ]
}
